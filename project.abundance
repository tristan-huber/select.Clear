      "interpreterVersion": 1,
      "code": "function run(selection: Assembly, clearFaces: boolean, clearEdges: boolean, clearParts: boolean) {\n  return selection.onLeafs((leaf) => {\n    if (leaf.selection) {\n      if (clearFaces) leaf.selection.faces = []\n      if (clearEdges) leaf.selection.edges = []\n      if (clearParts) leaf.selection.part = false;\n    }\n    return leaf;\n  })\n}",
      "compiledCode": "\"use strict\";\nfunction run(selection, clearFaces, clearEdges, clearParts) {\n    return selection.onLeafs((leaf) => {\n        if (leaf.selection) {\n            if (clearFaces)\n                leaf.selection.faces = [];\n            if (clearEdges)\n                leaf.selection.edges = [];\n            if (clearParts)\n                leaf.selection.part = false;\n        }\n        return leaf;\n    });\n}\n"
